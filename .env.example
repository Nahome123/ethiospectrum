NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional for the credential-free marketing build. Configure both values for local Supabase Auth work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC or import it into Client Components.
SUPABASE_SECRET_KEY=

# Server-only Stripe test/live configuration. The secret key and webhook secret are
# required together; they enable one-time Consultation / IEP payments and refunds.
# STRIPE_RBT_MONTHLY_PRICE_ID is the recurring monthly Price for RBT Boot Camp.
# Set STRIPE_AUTOMATIC_TAX=true only when Stripe Tax is configured on the account.
# Never prefix secrets or Price IDs with NEXT_PUBLIC and never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RBT_MONTHLY_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false

# Distinct server-only secret for the protected notification worker
# (/api/workers/notifications): appointment reminders and email delivery.
NOTIFICATION_WORKER_SECRET=

# Optional transactional email through Resend. Configure both together; without
# them notifications stay in-app only. Never prefix with NEXT_PUBLIC.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# Server-only secret used only to invoke the protected document-processing route.
# Use a distinct high-entropy value; never reuse SUPABASE_SECRET_KEY.
DOCUMENT_PROCESSING_SECRET=

# Server-only OpenAI configuration for controlled document summaries.
# Never prefix these values with NEXT_PUBLIC or expose them to browser code.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=

# Distinct server-only secret for the protected document-summary worker route.
# Never reuse DOCUMENT_PROCESSING_SECRET or SUPABASE_SECRET_KEY.
DOCUMENT_SUMMARY_SECRET=

# Server-only OCR provider configuration. Configure all three values together;
# never prefix them with NEXT_PUBLIC or commit real credentials.
OCR_PROVIDER=
OCR_API_KEY=
OCR_MODEL=

# Distinct server-only secret for the protected document-OCR worker route.
# Never reuse DOCUMENT_PROCESSING_SECRET, DOCUMENT_SUMMARY_SECRET, or SUPABASE_SECRET_KEY.
DOCUMENT_OCR_SECRET=

# Document AI (processing, summaries, OCR, Q&A, chat) is retired for launch in
# config/features.ts; its settings above are unused until the feature is re-approved.

# Temporary diagnostic page /<locale>/debug-whoami (signed-in caller only). Leave unset
# except while diagnosing household resolution on a deployment.
ETHIOSPECTRUM_DEBUG_WHOAMI=
